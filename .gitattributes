# Normalize all text to LF in the repository and working tree.
# Part 1 document tests and the Part 2 engine (TypeScript/ESLint/Prettier,
# canonical JSON hashing) both require deterministic LF line endings.
* text=auto eol=lf

# Explicit binary types that must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.m4a binary
